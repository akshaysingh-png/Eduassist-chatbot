    with open(LEARNED_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)


class SessionLogger:
    """Milestone 4 & 5 — log chats and feedback for analysis."""

    def __init__(self) -> None:
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        self._data = self._read_all()
        self._session: dict | None = None

    def _read_all(self) -> dict:
        if not SESSIONS_FILE.exists():
            return {"sessions": []}
        with open(SESSIONS_FILE, encoding="utf-8") as f:
            return json.load(f)

    def _write_all(self) -> None:
        with open(SESSIONS_FILE, "w", encoding="utf-8") as f:
            json.dump(self._data, f, indent=2)

    def start(self) -> str:
        sid = str(uuid.uuid4())[:8]
        self._session = {
            "id": sid,
            "started_at": datetime.now(timezone.utc).isoformat(),
            "ended_at": None,
            "messages": [],
            "feedback": None,
        }
        return sid

    def log_exchange(self, user: str, result: dict) -> None:
        if not self._session:
            return
        self._session["messages"].append(
            {"role": "user", "content": user, "at": datetime.now(timezone.utc).isoformat()}
        )
        self._session["messages"].append(
            {
                "role": "bot",
                "content": result["reply"],
                "intent": result["intent"],
                "confidence": result["confidence"],
                "at": datetime.now(timezone.utc).isoformat(),
            }
        )

    def end(self, rating: int | None = None, comment: str = "") -> None:
        if not self._session:
            return
        self._session["ended_at"] = datetime.now(timezone.utc).isoformat()
        if rating is not None:
            self._session["feedback"] = {"rating": rating, "comment": comment}
        self._data["sessions"].append(self._session)
        self._write_all()
        self._session = None

    @property
    def sessions(self) -> list[dict]:
        return self._data.get("sessions", [])


class EduAssistChatbot:
    """Milestone 2 & 3 — chatbot prototype with integrated NLP."""

    def __init__(self) -> None:
        self._pairs: list[tuple[str, str]] = []
        self._learned = _load_learned_examples()
        for intent, data in KNOWLEDGE_BASE.items():
            examples = list(data["examples"]) + self._learned.get(intent, [])
            for example in examples:
                self._pairs.append((intent, example.lower()))

    def learn_phrase(self, intent: str, phrase: str) -> bool:
        """Milestone 6 — add a new training phrase from user testing."""
        if intent not in KNOWLEDGE_BASE:
            return False
        phrase = phrase.strip().lower()
        if not phrase:
            return False
        data = _load_learned_examples()
        bucket = data.setdefault(intent, [])
        if phrase not in bucket and phrase not in [e.lower() for e in KNOWLEDGE_BASE[intent]["examples"]]:
            bucket.append(phrase)
            _save_learned_examples(data)
            self._pairs.append((intent, phrase))
            self._learned = data
        return True

    def classify_intent(self, user_message: str) -> tuple[str, float]:
        """Detect intent using examples, keywords, and context rules."""
        raw = user_message.strip()
        if not raw:
            return "fallback", 0.0

        query = normalize_message(raw)
        if not query:
            return "fallback", 0.0

        # Fast path: short greetings / goodbyes
        if query in ("hello", "hi", "hey", "hii", "helo", "good morning", "good evening"):
            return "greeting", 1.0
        if query in ("bye", "goodbye", "thanks", "thank you", "thankyou", "see you"):
            return "goodbye", 1.0

        scores: dict[str, float] = {intent: 0.0 for intent in KNOWLEDGE_BASE}

        for intent, example in self._pairs:
            sim = example_similarity(query, example)
            if sim > scores[intent]:
                scores[intent] = sim

        for intent in KNOWLEDGE_BASE:
            kw = keyword_intent_score(query, intent)
            scores[intent] = max(scores[intent], kw)

        has_fee = bool(
            re.search(r"\b(fee|fees|cost|price|pay|payment|refund|scholarship|expensive|cheap)\b", query)
            or "how much" in query
        )
        has_enroll = bool(
            re.search(r"\b(enroll|enrollment|register|registration|admission|join|sign up|signup)\b", query)
        )
        has_course_word = bool(re.search(r"\b(course|courses|program|programs|subject|college|class)\b", query))

        if re.search(r"\b(homework|assignment|quiz|grade|marks|deadline|marksheet)\b", query):
            scores["assignments"] = max(scores["assignments"], 0.82)
        if has_fee:
            scores["payments"] = max(scores["payments"], 0.88)
        if has_enroll:
            scores["enrollment"] = max(scores["enrollment"], 0.88)
        if has_course_word and not has_fee and not has_enroll:
            scores["courses_info"] = max(scores["courses_info"], 0.72)
        if re.search(r"\b(want to|wish to)\b", query) and has_course_word and not has_fee:
            scores["enrollment"] = max(scores["enrollment"], 0.8)
        if re.search(r"\b(teacher|teachers|faculty|instructor|professor|mentor|tutor|trainer)\b", query):
            scores["faculty"] = max(scores["faculty"], 0.92)
        # "courses available" must not be confused with live session recordings
        if has_course_word and re.search(r"\bavailable\b", query):
            scores["courses_info"] = max(scores["courses_info"], 0.95)
            scores["live_sessions"] *= 0.25

        best_intent = max(scores, key=scores.get)
        best_score = scores[best_intent]

        if best_score < CONFIDENCE_THRESHOLD:
            return "fallback", best_score
        return best_intent, best_score

    def extract_course_topics(self, user_message: str) -> list[str]:
        """Detect course names only as whole words (avoids false matches)."""
        lower = normalize_message(user_message)
        found = []
        for keyword, label in COURSE_KEYWORDS.items():
            if len(keyword) <= 4:
                matched = re.search(r"\b" + re.escape(keyword) + r"\b", lower)
            else:
                matched = keyword in lower
            if matched and label not in found:
                found.append(label)
        return found

    def resolve_intents(self, user_message: str) -> list[str]:
        """Pick one or more topics when a question covers multiple areas."""
        query = normalize_message(user_message)
        if not query:
            return []

        has_course = bool(re.search(r"\b(course|courses|program|programs|subject|subjects)\b", query))
        has_fee = bool(
            re.search(r"\b(fee|fees|cost|price|payment|pay|scholarship|refund)\b", query)
            or "fee structure" in query
            or "how much" in query
        )
        has_teacher = bool(
            re.search(r"\b(teacher|teachers|faculty|instructor|professor|mentor|tutor|trainer)\b", query)
            or "who teaches" in query
        )

        # Dedicated topics (no other mixing unless clearly combined)
        if has_teacher and not has_course and not has_fee:
            return ["faculty"]

        intents: list[str] = []
        if has_course:
            intents.append("courses_info")
        if has_fee:
            intents.append("payments")

        if len(intents) >= 2:
            return intents

        if intents:
            return intents

        primary, _ = self.classify_intent(user_message)
        return [] if primary == "fallback" else [primary]

    def _compose_reply(self, intents: list[str], user_message: str) -> str:
        """Build a polished answer for single or multi-topic questions."""
        labels = {
            "courses_info": "Courses offered",
            "payments": "Fee structure",
            "enrollment": "Enrollment",
            "technical_support": "Technical support",
            "faculty": "Faculty & instructors",
            "live_sessions": "Live classes",
            "assignments": "Assignments",
            "career": "Career support",
            "contact": "Contact",
            "account": "Account settings",
            "greeting": "Welcome",
            "goodbye": "Goodbye",
        }

        if len(intents) == 1:
            reply = KNOWLEDGE_BASE[intents[0]]["response"]
        else:
            parts = []
            for intent in intents:
                title = labels.get(intent, intent.replace("_", " ").title())
                body = KNOWLEDGE_BASE[intent]["response"]
                parts.append(f"**{title}**\n{body}")
            reply = "\n\n".join(parts)

        topics = self.extract_course_topics(user_message)
        if topics and any(i in ("courses_info", "enrollment", "faculty") for i in intents):
            reply += (
                f"\n\n**{topics[0]}** — see Courses -> {topics[0]} on the portal "
                "for syllabus, instructor, fees, and batch dates."
            )
        return reply

    def get_reply(self, user_message: str) -> dict:
        """Return bot reply with intent and confidence for analysis."""
        if looks_like_noise(user_message):
            return {
                "user_message": user_message,
                "intent": "fallback",
                "confidence": 0.0,
                "reply": (
                    "That looks like the **Run** command from your editor, not a question.\n"
                    "Do not paste the terminal command here — just type your question.\n\n"
                    "Examples:\n"
                    "  - What courses are available?\n"
                    "  - How much are the fees?\n"
                    "  - Who are the teachers?"
                ),
            }

        query = normalize_message(user_message)
        if query in ("hello", "hi", "hey", "hii", "helo", "good morning", "good evening"):
            return {
                "user_message": user_message,
                "intent": "greeting",
                "confidence": 1.0,
                "reply": KNOWLEDGE_BASE["greeting"]["response"],
            }
        if query in ("bye", "goodbye", "thanks", "thank you", "thankyou", "see you"):
            return {
                "user_message": user_message,
                "intent": "goodbye",
                "confidence": 1.0,
                "reply": KNOWLEDGE_BASE["goodbye"]["response"],
            }

        intents = self.resolve_intents(user_message)
        if not intents:
            _, confidence = self.classify_intent(user_message)
            return {
                "user_message": user_message,
                "intent": "fallback",
                "confidence": round(confidence, 2),
                "reply": FALLBACK_RESPONSE,
            }

        _, confidence = self.classify_intent(user_message)
        intent_label = "+".join(intents) if len(intents) > 1 else intents[0]
        reply = self._compose_reply(intents, user_message)

        return {
            "user_message": user_message,
            "intent": intent_label,
            "confidence": round(confidence, 2),
            "reply": reply,
        }


