            print("Please enter a number from 1 to 5.")

    comment = input("\nOverall comment (optional): ").strip()
    avg = sum(ratings) / len(ratings)
    logger.end(rating=round(avg), comment=comment)

    print(f"\nTesting complete. Average rating: {avg:.2f}/5")
    print(f"Data saved to: {SESSIONS_FILE}")
    print("Run: python eduassist_chatbot.py --analyze")
    print("Then: python eduassist_chatbot.py --improve\n")


def analyze_user_data() -> dict:
    """Milestone 5 — analyse logged sessions and print KPIs."""
    logger = SessionLogger()
    sessions = logger.sessions

    print("=" * 60)
    print("MILESTONE 5: Analyse User Data")
    print("=" * 60)

    if not sessions:
        print("\nNo session data yet. Run: python eduassist_chatbot.py --test")
        print("Or use live chat and exit with a rating.\n")
        return {}

    total_messages = 0
    user_turns = 0
    confidences: list[float] = []
    intents: Counter = Counter()
    fallbacks = 0
    bot_turns = 0
    ratings: list[int] = []

    for s in sessions:
        if s.get("feedback") and s["feedback"].get("rating"):
            ratings.append(int(s["feedback"]["rating"]))
        for m in s.get("messages", []):
            total_messages += 1
            if m["role"] == "user":
                user_turns += 1
            if m["role"] == "bot":
                bot_turns += 1
                intent = m.get("intent", "")
                intents[intent] += 1
                if intent == "fallback":
                    fallbacks += 1
                if m.get("confidence") is not None:
                    confidences.append(float(m["confidence"]))

    avg_conf = sum(confidences) / len(confidences) if confidences else 0.0
    fallback_rate = fallbacks / bot_turns if bot_turns else 0.0
    avg_rating = sum(ratings) / len(ratings) if ratings else 0.0
    resolution_proxy = round(1 - fallback_rate, 3)

    report = {
        "total_sessions": len(sessions),
        "total_messages": total_messages,
        "user_turns": user_turns,
        "average_confidence": round(avg_conf, 3),
        "fallback_rate": round(fallback_rate, 3),
        "resolution_proxy": resolution_proxy,
        "average_satisfaction": round(avg_rating, 2),
        "intent_distribution": dict(intents),
        "ratings_collected": len(ratings),
    }

    print(f"\nSessions analysed: {report['total_sessions']}")
    print(f"User messages: {report['user_turns']}")
    print(f"Average NLP confidence: {report['average_confidence']}")
    print(f"Fallback rate: {report['fallback_rate']} (lower is better)")
    print(f"Resolution proxy (1 - fallback): {report['resolution_proxy']}")
    print(f"Average user satisfaction: {report['average_satisfaction']}/5 ({report['ratings_collected']} ratings)")
    print("\nIntent distribution:")
    for name, count in sorted(intents.items(), key=lambda x: -x[1]):
        print(f"  {name}: {count}")

    report_path = DATA_DIR / "analytics_report.json"
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    with open(report_path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2)
    print(f"\nReport saved: {report_path}\n")
    return report


def apply_improvements() -> int:
    """Milestone 6 — learn new phrases from failed/low-confidence interactions."""
    logger = SessionLogger()
    bot = EduAssistChatbot()
    added = 0

    print("=" * 60)
    print("MILESTONE 6: Implement Improvements")
    print("=" * 60)

    fallback_phrases: list[str] = []
    for s in logger.sessions:
        msgs = s.get("messages", [])
        for i, m in enumerate(msgs):
            if m.get("role") == "bot" and m.get("intent") == "fallback" and i > 0:
                prev = msgs[i - 1]
                if prev.get("role") == "user":
                    fallback_phrases.append(prev["content"])

    if not fallback_phrases:
        print("\nNo fallback questions in logs — bot is performing well.")
        print("Run --test first or chat live to generate improvement data.\n")
        return 0

    unique = list({normalize_message(p): p for p in fallback_phrases}.values())
    print(f"\nFound {len(unique)} unique unanswered-style question(s).\n")

    for phrase in unique:
        norm = normalize_message(phrase)
        probe = EduAssistChatbot()
        intent, conf = probe.classify_intent(phrase)
        if intent == "fallback":
            intents = probe.resolve_intents(phrase)
            intent = intents[0] if intents else "courses_info"
        if conf < 0.5 and not probe.resolve_intents(phrase):
            q = norm
            if re.search(r"\b(fee|fees|cost|price)\b", q):
                intent = "payments"
            elif re.search(r"\b(enroll|register|admission)\b", q):
                intent = "enrollment"
            elif re.search(r"\b(teacher|faculty)\b", q):
                intent = "faculty"
            elif re.search(r"\b(course|courses)\b", q):
                intent = "courses_info"

        if bot.learn_phrase(intent, phrase):
            print(f"  Learned [{intent}]: {phrase[:70]}")
            added += 1

    print(f"\nAdded {added} new training phrase(s) to {LEARNED_FILE}")
    print("Restart chat to use improved responses.\n")
    return added


