def normalize_message(text: str) -> str:
    """Clean and fix common spelling before matching."""
    q = text.lower().strip()
    for wrong, right in TYPO_FIXES.items():
        q = q.replace(wrong, right)
    q = re.sub(r"[^\w\s?']", " ", q)
    q = re.sub(r"\s+", " ", q).strip()
    return q


def looks_like_noise(text: str) -> bool:
    """Detect pasted terminal run commands (not real customer questions)."""
    t = text.strip()
    lower = t.lower()
    if not t:
        return False
    noise_markers = (
        ".venv",
        "bin/python",
        "eduassist_chatbot.py",
        "Users/",
        "Leetcode practise",
    )
    if any(m in t for m in noise_markers):
        return True
    if t.startswith("/") or t.startswith('"') and "/" in t:
        return True
    if lower.count("/") >= 2 and "python" in lower:
        return True
    return False


def text_similarity(a: str, b: str) -> float:
    """Character-level similarity."""
    return SequenceMatcher(None, a.lower(), b.lower()).ratio()


def token_jaccard(a: str, b: str) -> float:
    """Word overlap similarity (handles rephrased questions well)."""
    words_a = set(a.split())
    words_b = set(b.split())
    if not words_a or not words_b:
        return 0.0
    return len(words_a & words_b) / len(words_a | words_b)


def example_similarity(query: str, example: str) -> float:
    """Best of character + word similarity."""
    return max(text_similarity(query, example), token_jaccard(query, example))


def _keyword_in_text(query: str, keyword: str) -> bool:
    """Match whole words so 'scholarship' does not match 'hi'."""
    if len(keyword) <= 3:
        return re.search(r"\b" + re.escape(keyword) + r"\b", query) is not None
    return keyword in query


def keyword_intent_score(query: str, intent: str) -> float:
    """Score intent from important words in the customer's message."""
    q = query.lower()
    keywords = INTENT_KEYWORDS.get(intent, [])
    hits = sum(1 for kw in keywords if _keyword_in_text(q, kw))
    if hits == 0:
        return 0.0
    return min(0.5 + hits * 0.1, 0.92)


def _load_learned_examples() -> dict[str, list[str]]:
    if not LEARNED_FILE.exists():
        return {}
    with open(LEARNED_FILE, encoding="utf-8") as f:
