def run_interactive() -> None:
    """Milestone 2 — live chatbot prototype with logging."""
    bot = EduAssistChatbot()
    logger = SessionLogger()
    logger.start()

    print("=" * 60)
    print("MILESTONE 2 & 3: Chatbot Prototype + NLP")
    print("EduAssist - LearnHub Online College Support")
    print("=" * 60)
    print(f"\nEduAssist: {KNOWLEDGE_BASE['greeting']['response']}")
    print("\nAsk about courses, fees, teachers, enrollment, assignments, or tech issues.")
    print("Commands: quit | learn <intent> <your phrase>  (teach the bot)")
    print("(Do not paste the python run command here.)\n")

    while True:
        try:
            user = input("You: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n\nEduAssist: Goodbye!")
            _ask_exit_feedback(logger)
            break

        if not user:
            continue

        if looks_like_noise(user):
            print(
                "\nEduAssist: That is the program launch command, not a question.\n"
                "Please type something like: What courses are available?\n"
            )
            continue

        if user.lower().startswith("learn "):
            parts = user.split(maxsplit=2)
            if len(parts) >= 3 and parts[1] in KNOWLEDGE_BASE:
                ok = bot.learn_phrase(parts[1], parts[2])
                print(
                    f"\nEduAssist: {'Learned new phrase.' if ok else 'Already known.'}\n"
                )
            else:
                print(
                    "\nEduAssist: Usage: learn <intent> <phrase>\n"
                    f"Intents: {', '.join(KNOWLEDGE_BASE.keys())}\n"
                )
            continue

        if user.lower() in ("quit", "exit", "bye", "goodbye"):
            farewell = bot.get_reply("goodbye")
            logger.log_exchange(user, farewell)
            print(f"\nEduAssist: {farewell['reply']}")
            _ask_exit_feedback(logger)
            break

        result = bot.get_reply(user)
        logger.log_exchange(user, result)
        print(f"\nEduAssist: {result['reply']}\n")


