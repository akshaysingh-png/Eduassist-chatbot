def run_user_testing() -> None:
    """Milestone 4 — structured user testing with ratings."""
    bot = EduAssistChatbot()
    logger = SessionLogger()
    sid = logger.start()
    ratings: list[int] = []

    print("=" * 60)
    print("MILESTONE 4: User Testing Phase")
    print("=" * 60)
    print(f"Session ID: {sid}")
    print("8 standard test scenarios — rate each 1 (poor) to 5 (excellent).\n")

    for title, question in USER_TEST_SCENARIOS:
        result = bot.get_reply(question)
        logger.log_exchange(question, result)
        print(f"--- {title} ---")
        print(f"User: {question}")
        print(f"Intent: {result['intent']} | Confidence: {result['confidence']}")
        print(f"Bot: {result['reply'][:200]}{'...' if len(result['reply']) > 200 else ''}\n")
        while True:
            try:
                raw = input("Your rating (1-5, or Enter=5): ").strip()
